<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="production_report" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="TOTAL_PRODUCTION" class="java.lang.String"/>
    <parameter name="TOTAL_DEFECTS" class="java.lang.String"/>
    <parameter name="QUALITY_RATE" class="java.lang.String"/>
    <parameter name="LINES_TEXT" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>

    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Rapport de Production]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="535" height="20"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="58" width="535" height="18"/>
                <textElement textAlignment="Center"><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Periode analysee : " + $P{PERIOD_LABEL}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="1"/>
    </detail>

    <summary>
        <band height="320">
            <staticText>
                <reportElement x="0" y="0" width="535" height="20"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Indicateurs generaux]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="25" width="535" height="18"/>
                <textFieldExpression><![CDATA["Production totale : " + $P{TOTAL_PRODUCTION} + " unites"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="45" width="535" height="18"/>
                <textFieldExpression><![CDATA["Nombre de defauts : " + $P{TOTAL_DEFECTS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="65" width="535" height="18"/>
                <textFieldExpression><![CDATA["Taux de qualite : " + $P{QUALITY_RATE} + " %"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="95" width="535" height="20"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Production par ligne]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="120" width="535" height="150"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{LINES_TEXT}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="290" width="535" height="18"/>
                <textElement textAlignment="Right"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Genere le : " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
