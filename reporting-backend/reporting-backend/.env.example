# ============================
# Fichier d'exemple pour les variables d'environnement
# Copier ce fichier en .env et remplir avec vos valeurs réelles
# NE JAMAIS COMMITER LE FICHIER .env !
# ============================

# Serveur
SERVER_PORT=8080

# Base de données
DB_URL=jdbc:mysql://localhost:3306/reporting_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=reporting_user
DB_PASSWORD=CHANGE_ME

# JWT (CRITIQUE : Générer une clé forte unique)
# Exemple de génération : openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_SECRET_KEY_AT_LEAST_256_BITS
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password

# Répertoires
UPLOAD_DIR=/var/app/uploads
REPORTS_DIR=/var/app/reports
PHOTOS_DIR=/var/app/photos

# Logs
LOG_FILE=/var/log/reporting-backend/application.log

# SSL (pour HTTPS)
SSL_ENABLED=true
SSL_KEYSTORE=/etc/ssl/keystore.p12
SSL_KEYSTORE_PASSWORD=CHANGE_ME

# Scheduler
SCHEDULER_CRON=0 0 8 * * *
